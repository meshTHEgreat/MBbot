{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mbbot.portal.engine-params.v1",
  "title": "MBbot portal backtest request (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family",
    "trigger",
    "delta_band",
    "dte_range",
    "session_window",
    "liquidity",
    "risk",
    "exits",
    "costs",
    "symbols",
    "window",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "mbbot.portal.engine-params.v1"},
    "family": {
      "enum": [
        "trend_persistence",
        "opening_range_breakout",
        "orderflow_imbalance",
        "premium_underlying_divergence",
        "mean_reversion_fade"
      ]
    },
    "trigger": {
      "type": "object",
      "description": "Family-specific trigger parameters; keys depend on family.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fast_ma_snapshots", "slow_ma_snapshots", "ma_gap_min_pct", "momentum_minutes", "momentum_min_pct"],
          "properties": {
            "fast_ma_snapshots": {"type": "integer", "minimum": 1},
            "slow_ma_snapshots": {"type": "integer", "minimum": 2, "maximum": 66},
            "ma_gap_min_pct": {"type": "number"},
            "momentum_minutes": {"enum": [5, 10, 15, 30, 60]},
            "momentum_min_pct": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["range_minutes", "buffer_pct", "regime_filter_enabled", "regime_max_width_vs_prior5"],
          "properties": {
            "range_minutes": {"type": "integer", "minimum": 5, "maximum": 120, "multipleOf": 5},
            "buffer_pct": {"type": "number", "minimum": 0.0, "maximum": 5.0},
            "regime_filter_enabled": {"type": "boolean"},
            "regime_max_width_vs_prior5": {"type": "number", "exclusiveMinimum": 0.0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["window_bars", "imbalance_threshold", "require_underlying_agreement"],
          "properties": {
            "window_bars": {"type": "integer", "minimum": 1, "maximum": 12},
            "imbalance_threshold": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
            "require_underlying_agreement": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["window_minutes", "underlying_velocity_min_pct_per_minute", "premium_velocity_max_pct_per_minute"],
          "properties": {
            "window_minutes": {"enum": [5, 10, 15, 30, 60]},
            "underlying_velocity_min_pct_per_minute": {"type": "number", "exclusiveMinimum": 0.0},
            "premium_velocity_max_pct_per_minute": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rsi_period", "rsi_extreme", "require_reversal_bar"],
          "properties": {
            "rsi_period": {"type": "integer", "minimum": 2, "maximum": 50},
            "rsi_extreme": {"type": "number", "exclusiveMinimum": 50.0, "maximum": 100.0},
            "require_reversal_bar": {"type": "boolean"}
          }
        }
      ]
    },
    "delta_band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "minimum", "maximum"],
      "properties": {
        "target": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "minimum": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "maximum": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0}
      }
    },
    "dte_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0, "maximum": 30},
        "maximum": {"type": "integer", "minimum": 0, "maximum": 30}
      }
    },
    "session_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_start", "entry_end"],
      "description": "Must sit inside the fixed 09:45:00-15:00:00 entry bounds; force close is always 15:55:00.",
      "properties": {
        "entry_start": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$"},
        "entry_end": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$"}
      }
    },
    "liquidity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_relative_spread_percent", "minimum_midpoint", "require_valid_nbbo"],
      "properties": {
        "maximum_relative_spread_percent": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 100.0},
        "minimum_midpoint": {"type": "number", "minimum": 0.0},
        "require_valid_nbbo": {"type": "boolean"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts_per_trade", "maximum_trades_per_symbol_session", "reentry_cooldown_minutes", "correlated_exposure_skip"],
      "properties": {
        "contracts_per_trade": {"type": "integer", "minimum": 1, "maximum": 100},
        "maximum_trades_per_symbol_session": {"type": "integer", "minimum": 1},
        "reentry_cooldown_minutes": {"type": "integer", "minimum": 0},
        "correlated_exposure_skip": {"type": "boolean"}
      }
    },
    "exits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalidation_enabled", "profit_target_mode", "profit_target_friction_multiple", "profit_target_percent", "time_stop_minutes", "premium_stop_enabled", "premium_stop_percent"],
      "properties": {
        "invalidation_enabled": {"type": "boolean"},
        "profit_target_mode": {"enum": ["friction_multiple", "percent"]},
        "profit_target_friction_multiple": {"type": "number", "exclusiveMinimum": 0.0},
        "profit_target_percent": {"type": ["number", "null"], "exclusiveMinimum": 0.0},
        "time_stop_minutes": {"type": "integer", "minimum": 5, "maximum": 375},
        "premium_stop_enabled": {"type": "boolean"},
        "premium_stop_percent": {"type": ["number", "null"], "exclusiveMinimum": 0.0, "exclusiveMaximum": 100.0}
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commission_per_contract_per_side"],
      "properties": {
        "commission_per_contract_per_side": {"type": "number", "minimum": 0.0}
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["AAPL", "NVDA", "QQQ", "SPY", "TSLA"]}
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "provenance": {
      "type": "object",
      "description": "Opaque UI provenance; echoed verbatim into the report."
    }
  }
}
