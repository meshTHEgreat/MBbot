  "rules": [
    {
      "id": "dataset-tier-one-features",
      "cause": "dataset_version",
      "condition": { "equals": "v1" },
      "effects": [
        {
          "targets": ["iv_source", "vega_filter", "rho_filter", "open_interest_minimum", "iv_rank_gate"],
          "behavior": "disable",
          "reason": "Tier-1 Greeks and open interest need the 12-month dataset (v2) — currently v1 selected."
        }
      ]
    },
    {
      "id": "dataset-window-bindings",
      "cause": "dataset_version",
      "effects": [
        {
          "targets": ["window_preset", "symbol_combobox"],
          "behavior": "dataset_binding",
          "values": {
            "v1": {
              "discovery_start": "2026-04-27",
              "discovery_end": "2026-05-22",
              "holdout_start": "2026-05-26",
              "holdout_end": "2026-07-24",
              "symbols": ["SPY", "QQQ", "AAPL", "NVDA", "TSLA"]
            },
            "v2": {
              "discovery_start": "2025-04-28",
              "discovery_end": "2026-04-24",
              "symbols": ["SPY", "QQQ", "AAPL", "NVDA", "TSLA"]
            }
          }
        },
        {
          "targets": ["stage_0_summary"],
          "behavior": "ripple_only"
        }
      ]
    },
    {
      "id": "trigger-family-parameters",
      "cause": "trigger_family",
      "effects": [
        {
          "targets": [
            "params_trend_persistence",
            "params_opening_range",
            "params_order_flow",
            "params_premium_divergence",
            "params_mean_reversion",
            "params_legacy_macd"
          ],
          "behavior": "activate_matching_group",
          "reason_template": "Available when Trigger family is {label}."
        },
        {
          "targets": ["invalidation_formula", "warmup_requirement", "signal_price_source", "regime-rule"],
          "behavior": "mapped_content",
          "values": {
            "trend_persistence": {
              "invalidation_formula": "Exit calls when the underlying falls to or below the slow 60-minute MA; exit puts when it rises to or above it.",
              "warmup_requirement": "12 trigger bars = 60 minutes at the 5-minute default.",
              "signal_price_source": "UNDERLYING snapshot price",
              "regime-rule": "No regime rule for trend persistence."
            },
            "opening_range_breakout": {
              "invalidation_formula": "Adapter pending: research-side family structure is required.",
              "warmup_requirement": "Opening range plus family regime warm-up; adapter pending.",
              "signal_price_source": "UNDERLYING snapshot price",
              "regime-rule": "Prior-5-session opening-range regime, controlled by the Stage-2 regime toggle."
            },
            "order_flow_imbalance": {
              "invalidation_formula": "Adapter pending: research-side family structure is required.",
              "warmup_requirement": "Rolling imbalance window; adapter pending.",
              "signal_price_source": "OPTION trade flow plus underlying agreement",
              "regime-rule": "No separate regime rule for order-flow imbalance."
