    "warning_rules": [
      {
        "cause": "window_preset",
        "condition": { "equals": "holdout" },
        "targets": ["window_preset", "burn-ack"],
        "description": "Holdout requires an explicit acknowledgement and remains watermarked and logged."
      },
      {
        "cause": "commission_preset",
        "condition": { "equals": "zero" },
        "targets": ["commission_preset", "unrealistic_costs_acknowledged"],
        "description": "Zero cost requires an explicit unrealistic-cost acknowledgement and report watermark."
      },
      {
        "cause": "allow_zero_dte",
        "condition": { "truthy": true },
        "targets": ["allow_zero_dte"],
        "description": "0DTE is outside preregistered scope and stamps the adapter envelope and report."
      },
      {
        "cause": "spread_cap_percent",
        "condition": { "greater_than": 15 },
        "targets": ["spread_cap_percent"],
        "description": "A spread cap above 15% is visually flagged for explicit review."
      }
    ],
