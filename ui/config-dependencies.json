    { "stage": 0, "name": "Data & Window", "short_name": "Data", "requirement": "required", "next_label": "Next: Regime ->" },
    { "stage": 1, "name": "Regime", "short_name": "Regime", "requirement": "optional", "next_label": "Next: Setup & Trigger ->" },
    { "stage": 2, "name": "Setup & Trigger", "short_name": "Trigger", "requirement": "required", "next_label": "Next: Filters ->", "fast_review_label": "Accept optional defaults · Review & run ->" },
    { "stage": 3, "name": "Filters", "short_name": "Filters", "requirement": "optional", "next_label": "Next: Contract selection ->" },
    { "stage": 4, "name": "Contract selection", "short_name": "Contract", "requirement": "optional", "next_label": "Next: Execution & Costs ->" },
    { "stage": 5, "name": "Execution & Costs", "short_name": "Costs", "requirement": "required", "next_label": "Next: Risk ->" },
    { "stage": 6, "name": "Risk", "short_name": "Risk", "requirement": "optional", "next_label": "Next: Exits ->" },
    { "stage": 7, "name": "Exits", "short_name": "Exits", "requirement": "optional", "next_label": "Review & run ->" },
    { "stage": 8, "name": "Review & Run", "short_name": "Review", "requirement": "required" }
  ],
  "state_legend": [
    {
      "id": "queue_effective",
      "icon": "circle-check",
      "label": "Queue-effective now",
      "description": "You can change it and the current runner will use it."
    },
    {
      "id": "adapter_only",
      "icon": "circle-dashed",
      "label": "Adapter-only",
      "description": "It is recorded in the adapter envelope but does not affect today's legacy run."
    },
    {
      "id": "locked",
      "icon": "lock-keyhole",
      "label": "Read-only or unavailable",
      "description": "You cannot change it in the current state; the visible reason names the cause."
    },
    {
      "id": "warning",
      "icon": "triangle-alert",
      "label": "Explicit acknowledgement",
      "description": "This setting requires a deliberate scope or cost acknowledgement."
    }
  ],
  "optional_stages": [
    {
      "stage": 1,
      "button_label": "View defaults",
      "reset_label": "Hide details",
      "default_summary": "Optional — defaults: family-supplied regime slot and calculated warm-up.",
      "controls_target": "optional-controls-1",
      "read_only": true,
      "defaults": {}
    },
    {
      "stage": 3,
      "button_label": "Customize",
      "reset_label": "Reset to defaults",
      "default_summary": "Optional — defaults: 10% midpoint spread, $0.50 floor, valid NBBO, indicator gates off.",
      "controls_target": "optional-controls-3",
      "read_only": false,
      "defaults": {
        "spread_cap_percent": 10,
        "spread_denominator": "midpoint",
        "premium_floor": 0.5,
        "premium_cap": "",
        "valid_nbbo_required": true,
        "rsi_gate_enabled": false,
        "smi_gate_enabled": false,
        "momentum_gate_enabled": false,
        "velocity_gate_enabled": false,
        "activity_gate_enabled": false,
        "trade_side_gate_enabled": false
      }
    },
    {
      "stage": 4,
      "button_label": "Customize",
      "reset_label": "Reset to defaults",
      "default_summary": "Optional — defaults: |Delta| 0.60 in a 0.50–0.70 band, 1–4 DTE, fallbacks on, 0DTE off.",
      "controls_target": "optional-controls-4",
      "read_only": false,
      "defaults": {
        "delta_minimum": 0.5,
        "delta_target": 0.6,
        "delta_maximum": 0.7,
        "dte_minimum": 1,
        "dte_maximum": 4,
        "allow_zero_dte": false,
        "expiration_fallback": true,
        "next_strike_scan": true
      }
    },
    {
      "stage": 6,
      "button_label": "Enable & customize",
      "reset_label": "Disable risk controls",
      "default_summary": "Optional — customization disabled; required adapter defaults apply: 1 contract, 3 trades/symbol/session, 30-minute cooldown, correlated-exposure protection on.",
      "controls_target": "optional-controls-6",
      "read_only": false,
      "activation": "opt_in",
      "activation_target": "risk_enabled",
      "inactive_title": "Risk customization disabled",
      "inactive_description": "The adapter requires risk values, so the visible certified defaults still apply until you enable customization.",
      "active_title": "Risk enabled",
      "active_description": "The configured limits are included in the adapter envelope.",
      "defaults": {
        "risk_enabled": false,
        "contracts_per_trade": 1,
        "maximum_trades_per_symbol_day": 3,
        "reentry_cooldown_minutes": 30,
        "same_direction_spy_qqq_single_exposure": true
      }
    },
    {
      "stage": 7,
      "button_label": "Customize",
      "reset_label": "Reset to defaults",
      "default_summary": "Optional — defaults: family invalidation, 3× friction, 60-minute time stop, 15:55 ET close; premium stop off.",
      "controls_target": "optional-controls-7",
      "read_only": false,
      "defaults": {
        "invalidation_stop_enabled": true,
        "profit_target_enabled": true,
        "profit_target_mode": "friction_multiple",
        "profit_friction_multiple": 3,
        "profit_legacy_percent": 20,
        "time_stop_enabled": true,
        "time_stop_minutes": 60,
        "premium_stop_enabled": false,
        "premium_stop_percent": 10,
        "opposite_smi_exit": false
      }
    }
  ],
